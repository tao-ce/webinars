\beamertemplatenavigationsymbolsempty

\colorlet{tao-primary}{tao-red!70!white}
\colorlet{tao-secondary}{tao-yellow!40!white}

\setbeamercolor{structure}{fg=tao-primary, bg=black}
\setbeamercolor*{palette primary}{use=structure, fg=tao-primary, bg=black}
\setbeamercolor*{palette secondary}{fg=tao-secondary, bg=black}
\setbeamercolor*{palette tertiary}{fg=white, bg=black}
\setbeamercolor*{palette quaternary}{fg=tao-secondary, bg=black}
\setbeamercolor{background canvas}{bg=black}
\setbeamercolor{normal text}{fg=white}
\setbeamercolor{alerted text}{fg=tao-secondary}
